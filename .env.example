# =============================================================================
# .env.example — Tổng hợp tất cả biến môi trường cho toàn hệ thống
# Sao chép thành .env và điền giá trị thực. KHÔNG commit file .env lên git.
# =============================================================================

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# LOG_LEVEL: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ─────────────────────────────────────────────
# SUPABASE
# Lấy từ: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# anon key: dùng cho frontend (public read)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# service_role key: chỉ dùng backend, TUYỆT ĐỐI không expose ra frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────
# SEPAY WEBHOOK
# Lấy từ: SePay Dashboard → Webhook Settings
# ─────────────────────────────────────────────
# Token xác thực webhook (Bearer token trong Authorization header)
SEPAY_WEBHOOK_TOKEN=your_sepay_webhook_secret_token_here

# ─────────────────────────────────────────────
# NGÂN HÀNG / VIETQR
# Dùng để sinh mã QR thanh toán động
# ─────────────────────────────────────────────
# Mã ngân hàng theo chuẩn VietQR (vd: MB, VCB, TCB, BIDV, ACB...)
BANK_ID=MB
# Số tài khoản thụ hưởng
BANK_ACCOUNT_NO=0123456789
# Tên chủ tài khoản (hiển thị trên QR)
BANK_ACCOUNT_NAME=NGUYEN VAN A

# ─────────────────────────────────────────────
# TELEGRAM BOT
# Lấy từ: Telegram @BotFather → /newbot
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chat ID của Admin (lấy từ @userinfobot hoặc @getidsbot)
# Hỗ trợ nhiều admin: phân cách bằng dấu phẩy (vd: 123456789,987654321)
ADMIN_TELEGRAM_CHAT_IDS=123456789

# ─────────────────────────────────────────────
# CLOUDINARY
# Lấy từ: Cloudinary Dashboard → Settings → API Keys
# Free tier: 25GB storage, 25GB bandwidth/tháng
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here
# Folder lưu ảnh bill trên Cloudinary
CLOUDINARY_UPLOAD_FOLDER=payment_reports

# ─────────────────────────────────────────────
# FRONTEND (Next.js) — prefix NEXT_PUBLIC_ để expose ra client
# ─────────────────────────────────────────────
# URL của backend Express (trỏ vào Render.com khi production)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Supabase anon key cho frontend
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Thông tin ngân hàng cho VietQR (public — chỉ là thông tin tài khoản nhận tiền)
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_ACCOUNT_NO=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=NGUYEN VAN A

# ─────────────────────────────────────────────
# CRON JOB
# ─────────────────────────────────────────────
# Cron expression: mỗi 1 phút kiểm tra đơn hết hạn
CRON_AUTO_CANCEL_EXPR=* * * * *
# Bật/tắt cron (true | false)
CRON_ENABLED=true
